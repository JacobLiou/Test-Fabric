{
  "ConnectionStrings": {
    "testfabric": "Host=localhost;Port=5433;Database=testfabric;Username=testfabric;Password=testfabric"
  },
  "TestFabric": {
    "Acquire": {
      "DefaultWaitTimeoutSeconds": 5,
      "PollIntervalMs": 250
    },
    "Lease": {
      "DefaultTtlSeconds": 60,
      "MinTtlSeconds": 5,
      "MaxTtlSeconds": 3600
    },
    "Scanner": {
      "Enabled": true,
      "IntervalMs": 1000
    },
    "Health": {
      "IntervalSeconds": 30,
      "FailThreshold": 3,
      "SuccessThreshold": 2,
      "L1TimeoutMs": 2000,
      "ProbeWaitMs": 2000
    },
    "Startup": {
      "LeaseGraceEnabled": true
    }
  },
  "Auth": {
    "Tokens": [
      { "Token": "dev-admin-token", "Role": "Administrator", "Subject": "dev-admin" },
      { "Token": "dev-engineer-token", "Role": "EquipmentEngineer", "Subject": "dev-engineer" },
      { "Token": "dev-client-token", "Role": "TestClient", "Subject": "station-dev" },
      { "Token": "dev-viewer-token", "Role": "Viewer", "Subject": "dev-viewer" }
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
